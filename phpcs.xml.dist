<?xml version="1.0"?>
<ruleset name="DJ Zen Eyer WordPress Plugins">
    <description>WordPress Coding Standards for changed first-party plugin PHP files.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
</ruleset>
